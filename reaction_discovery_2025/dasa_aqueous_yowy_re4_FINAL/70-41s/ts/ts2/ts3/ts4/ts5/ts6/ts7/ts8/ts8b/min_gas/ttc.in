coordinates     gas_0.xyz

#QM method
basis 6-31gs
method wb97xd3

##threspdp 1.0e-4 ##leaving this here

precision mixed
charge 0
spinmult 1
purify no
#dftgrid 1
maxit 200
##pcm cosmo
##epsilon 2.38
threall       1.0e-14
convthre      1.0e-7
threspdp      1.0e-4
min_tolerance   1.0e-3
min_tolerance_e 1.0e-5
nstep           9999

gpus                 1
run         minimize
end
