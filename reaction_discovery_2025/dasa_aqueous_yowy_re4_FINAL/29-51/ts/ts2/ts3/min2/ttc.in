prmtop       dasa-carved_ID.prmtop
coordinates     neb_9.rst7

#QM method
basis 6-31gs
method wb97xd3
qmindices      qm.txt

##threspdp 1.0e-4 ##leaving this here

precision mixed
charge 0
spinmult 1
purify no
#dftgrid 1
maxit 200
##pcm cosmo
##epsilon 2.38
threall       1.0e-14
convthre      1.0e-7
threspdp      1.0e-4

min_image       16
min_tolerance   0.75e-3
min_tolerance_e 0.75e-5
nstep           9999
##min_max_step    0.5

gpus                 1
ts_method neb_frozen
min_coordinates cartesian
run         minimize
end

