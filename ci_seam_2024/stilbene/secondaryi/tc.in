coordinates         geom.xyz 

#QM method
#guess             c0
basis               6-31gs
method              b3lyp 
dftd                yes
threall             1.0e-14
convthre            1.0e-7
threspdp            1.0e-4
precision           mixed
charge              0
spinmult            1
purify              no
dftgrid             1
maxit               100


fon                 yes
fon_method          constant 
closed              0
active              85


hhtda               yes
hhtdasinglets       4
cisnumstates        4
cisguessvecs        16
cismax              300
cismaxiter          500
cisconvtol          1.0e-6
cphftol             1.0e-6
cistarget           0
cphfiter            1000
gpus                1

run                 coupling
run                 gradient 
